# Example Caddy route for Hyperion. Replace the hostname before use.
# Mirrors the proven VPS pattern from the mcp.carlos-santos.es site block:
# Caddy performs Authentik forward_auth against the embedded outpost on
# loopback, copies only identity headers, and reverse-proxies to Hyperion.
# Hyperion independently requires X-Authentik-Username on all management
# endpoints, so the upstream only ever sees Authentik-verified identity.
hyperion.carlos-santos.es {
	# Cert behavior is a deployment input. Real hosts use custom certs:
	# tls /etc/caddy/certs/hyperion.crt /etc/caddy/certs/hyperion.key
	# Remove the comment to use ACME instead (the VPS has a global ACME email).
	route {
		encode zstd gzip

		# Health endpoints remain loopback-only (404 for any external hit).
		# Wildcard paths so /healthz/ cannot fall through to forward_auth.
		handle_path /healthz* {
			respond 404
		}
		handle_path /readyz* {
			respond 404
		}

		# Authentik outpost passthrough: the forward_auth redirect and
		# callback (https://<host>/outpost.goauthentik.io/callback) must
		# reach the outpost without re-entering forward_auth.
		reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000

		# Hyperion requires only X-Authentik-Username; copy_headers SET
		# semantics overwrite any client-supplied value with the Authentik
		# response, so header smuggling is not possible (verified).
		# Add Groups/Email here only when RBAC lands.
		forward_auth 127.0.0.1:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username
		}

		reverse_proxy 127.0.0.1:8787
	}
}
